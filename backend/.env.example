APP_NAME=LLM Serving API
APP_VERSION=0.1.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

MODEL_NAME=sshleifer/tiny-gpt2
QUANTIZATION=awq
